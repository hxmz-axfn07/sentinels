digraph incident {
  graph [rankdir=LR, bgcolor="transparent", pad="0.18", nodesep="0.34", ranksep="0.42", fontname="Arial", fontsize=12, label="Analyst-led incident lifecycle", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#31506B", fontname="Arial", fontsize=9, margin="0.11,0.07"];
  edge [color="#168C7B", penwidth=1.3, fontname="Arial", fontsize=8, arrowsize=0.7];
  event [label="Inspect persisted\nrule / ML / hybrid event"];
  create [label="Analyst creates incident\nwith selected evidence"];
  open [label="Open"];
  ack [label="Acknowledged"];
  investigate [label="Investigating\nappend notes + history"];
  resolved [label="Resolved\nresolution summary"];
  closed [label="Closed"];
  reopen [label="Reopen to investigation\nwhere valid"];
  event -> create -> open -> ack -> investigate -> resolved -> closed;
  resolved -> reopen [label="reopen"];
  reopen -> investigate;
  persist [shape=cylinder, label="Incident + evidence links\nnotes + append-only history"];
  investigate -> persist [style=dashed];
}
