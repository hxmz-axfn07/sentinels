digraph hybrid {
  graph [rankdir=LR, bgcolor="transparent", pad="0.18", nodesep="0.34", ranksep="0.44", fontname="Arial", fontsize=12, label="Hybrid evidence scoring", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#31506B", fontname="Arial", fontsize=9, margin="0.11,0.07"];
  edge [color="#168C7B", penwidth=1.3, fontname="Arial", fontsize=8, arrowsize=0.7];
  rules [label="Selected completed\nrule findings"];
  ml [label="Complete selected-model\ninference results"];
  groups [label="Analysis-scoped groups\nendpoint pair + protocol\nmissing endpoints isolated"];
  score [label="Rule noisy-OR + ranked ML\nindependent evidence combine\nexact shared-flow bonus once"];
  cap [label="Cap at 100\nmap configured severity band"];
  persist [shape=cylinder, label="Assessment + groups + evidence\nsource IDs and versions"];
  rules -> groups;
  ml -> groups;
  groups -> score -> cap -> persist;
  caveat [shape=note, fillcolor="#FFF4D6", color="#BD8B27", label="Risk score is investigation priority,\nnot probability of compromise."];
  cap -> caveat [style=dashed, arrowhead=none, color="#BD8B27"];
}
