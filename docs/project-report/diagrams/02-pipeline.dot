digraph pipeline {
  graph [rankdir=LR, bgcolor="transparent", pad="0.18", nodesep="0.30", ranksep="0.40", fontname="Arial", fontsize=12, label="PCAP-to-hybrid analysis pipeline", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#31506B", fontname="Arial", fontsize=9, margin="0.11,0.07"];
  edge [color="#168C7B", penwidth=1.3, fontname="Arial", fontsize=8, arrowsize=0.7];
  upload [label="PCAP / PCAPNG\nchunked upload"];
  validate [label="Content + size\nstructural + packet limit"];
  parse [label="Scapy parse\npacket metadata only"];
  packets [shape=cylinder, label="Persisted packets"];
  flows [label="Bidirectional flow\ngeneration"];
  rules [label="Rule detection\nexplicit or selected run"];
  ml [label="Inference with\nselected existing model"];
  hybrid [label="Hybrid assessment\nselected persisted rule + ML"];
  results [shape=cylinder, label="Findings, scores, provenance\nanalytics + incidents"];
  upload -> validate -> parse -> packets -> flows;
  flows -> rules;
  flows -> ml;
  rules -> hybrid;
  ml -> hybrid;
  rules -> results;
  ml -> results;
  hybrid -> results;
  note [shape=note, fillcolor="#FFF4D6", color="#BD8B27", label="Pipeline runs only requested eligible stages.\nIt never trains a model implicitly."];
  hybrid -> note [style=dashed, arrowhead=none, color="#BD8B27"];
}
