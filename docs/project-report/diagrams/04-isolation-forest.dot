digraph isolation_forest {
  graph [rankdir=LR, bgcolor="transparent", pad="0.18", nodesep="0.34", ranksep="0.48", fontname="Arial", fontsize=12, label="Isolation Forest training and inference", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#31506B", fontname="Arial", fontsize=9, margin="0.11,0.07"];
  edge [color="#168C7B", penwidth=1.3, fontname="Arial", fontsize=8, arrowsize=0.7];
  train [label="Explicitly selected completed\ntraining analyses (≥20 flows)"];
  features [label="flow-v1 numeric features\nmedian imputation + missingness\nlog1p + drop constants"];
  fit [label="Isolation Forest\nseed + config stored"];
  artifact [shape=cylinder, label="Generated private artifact\nmodel metadata + version"];
  inference [label="Selected analysis flows\nvalidate schema + sklearn version"];
  predict [label="predict label +\n−decision_function score"];
  results [shape=cylinder, label="Persisted per-flow results\nscore is not probability"];
  train -> features -> fit -> artifact;
  inference -> predict;
  artifact -> predict;
  predict -> results;
}
