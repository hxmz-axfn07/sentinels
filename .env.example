MYSQL_DATABASE=sentinel
MYSQL_USER=sentinel
MYSQL_PASSWORD=sentinel_dev_password
MYSQL_ROOT_PASSWORD=sentinel_root_dev_password
MYSQL_PORT=3307
DATABASE_URL=mysql+pymysql://sentinel:sentinel_dev_password@127.0.0.1:3307/sentinel
FRONTEND_ORIGIN=http://localhost:5174
UPLOAD_STORAGE_DIR=storage/pcaps
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_CAPTURE_PACKETS=100000
MODEL_STORAGE_DIR=storage/models
ML_MAX_TRAINING_SAMPLES=50000
HYBRID_SCORING_CONFIG__VERSION=hybrid-v1
HYBRID_SCORING_CONFIG__RULE_LOW_WEIGHT=10
HYBRID_SCORING_CONFIG__RULE_MEDIUM_WEIGHT=25
HYBRID_SCORING_CONFIG__RULE_HIGH_WEIGHT=45
HYBRID_SCORING_CONFIG__RULE_CRITICAL_WEIGHT=65
HYBRID_SCORING_CONFIG__ML_BASE_WEIGHT=20
HYBRID_SCORING_CONFIG__ML_RANK_WEIGHT=30
HYBRID_SCORING_CONFIG__EXACT_FLOW_BONUS=15
HYBRID_SCORING_CONFIG__SEVERITY_INFORMATIONAL_MAX=0
HYBRID_SCORING_CONFIG__SEVERITY_LOW_MAX=24
HYBRID_SCORING_CONFIG__SEVERITY_MEDIUM_MAX=49
HYBRID_SCORING_CONFIG__SEVERITY_HIGH_MAX=74
DETECTION_CONFIG__PORT_SCAN_ENABLED=true
DETECTION_CONFIG__PORT_SCAN_THRESHOLDS__LOW=5
DETECTION_CONFIG__PORT_SCAN_THRESHOLDS__MEDIUM=10
DETECTION_CONFIG__PORT_SCAN_THRESHOLDS__HIGH=25
DETECTION_CONFIG__PORT_SCAN_THRESHOLDS__CRITICAL=50
DETECTION_CONFIG__SYN_FLOOD_ENABLED=true
DETECTION_CONFIG__SYN_FLOOD_THRESHOLDS__LOW=20
DETECTION_CONFIG__SYN_FLOOD_THRESHOLDS__MEDIUM=100
DETECTION_CONFIG__SYN_FLOOD_THRESHOLDS__HIGH=500
DETECTION_CONFIG__SYN_FLOOD_THRESHOLDS__CRITICAL=1000
DETECTION_CONFIG__CONNECTION_ATTEMPTS_ENABLED=true
DETECTION_CONFIG__CONNECTION_ATTEMPTS_THRESHOLDS__LOW=10
DETECTION_CONFIG__CONNECTION_ATTEMPTS_THRESHOLDS__MEDIUM=25
DETECTION_CONFIG__CONNECTION_ATTEMPTS_THRESHOLDS__HIGH=50
DETECTION_CONFIG__CONNECTION_ATTEMPTS_THRESHOLDS__CRITICAL=100
